{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel 2>/dev/null) && python3 \"$repo_root/.codex/hooks/gitgps_route.py\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
